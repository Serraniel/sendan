{
  // SvelteKit generates a base with the module resolution and path aliases the
  // framework needs. It does not enable strict checking, so every option this
  // project relies on is restated below rather than inherited - inheriting a
  // base that changes between releases is how a guarantee quietly disappears.
  //
  // SvelteKit 3 serves that base as a virtual module rather than writing it into
  // .svelte-kit, and it no longer supplies include/exclude, so the file sets are
  // stated here where they used to be inherited.
  "extends": "$app/tsconfig",
  "include": ["src", "test", "*"],
  // The Service Worker and its test belong to tsconfig.worker.json, which
  // checks them under a worker scope instead of this DOM one - that is what
  // SvelteKit asks for, and it is better typing besides.
  //
  // Both files have to leave together. `exclude` only limits the root file set,
  // so excluding the worker while the test that imports it stays here pulls the
  // worker straight back into this program, under these libs. That is what used
  // to happen. See #320 and tsconfig.worker.json.
  "exclude": ["src/service-worker.ts", "src/service-worker.test.ts"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    // $app/types carries the generated route types. This list replaces the
    // base's rather than extending it, so it has to be named here.
    "types": ["$app/types", "vitest/globals", "node"]
  }
}
