# SPDX-License-Identifier: AGPL-3.0-or-later
#
# What never reaches the build context.
#
# Two reasons, and the second is the one that matters: a smaller context builds
# faster, and anything sent here can end up in an image layer. A build context
# is not a private channel.

# Version control history, which is large and reveals every past state of files
# that were later corrected.
.git
.github

# Build output. Copying a host build in would defeat the point of building in
# the image, and internal/webui/dist in particular is regenerated by the web
# stage - an inherited one would be silently preferred.
dist/
internal/webui/dist/
web/node_modules/
web/.svelte-kit/
web/build/

# Local state and anything that might hold credentials or real data.
data/
*.db
*.db-*
.env
.env.*
*.pem
*.key

# Test and coverage artefacts.
coverage.out
*.test
web/test-results/
web/playwright-report/

# Editor and operating system noise.
.idea/
.vscode/
*.swp
.DS_Store
