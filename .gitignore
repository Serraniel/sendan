# Binaries
/sendan
/sendan-cli
/dist/
/bin/
*.exe
*.dll
*.so
*.dylib

# Go
*.test
*.out
/vendor/
go.work
go.work.sum

# Embedded frontend build output (generated)
/internal/web/dist/

# Node / SvelteKit
node_modules/
/web/build/
/web/.svelte-kit/
/web/dist/
.pnpm-store/
*.tsbuildinfo

# Local runtime data — must never be committed
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Secrets and local config
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/**/*.key

# Tooling
.idea/
.vscode/
*.swp
.DS_Store
# Anchored and specific: an unanchored coverage.* also matched
# scripts/coverage.sh, which silently excluded a source file from the repository.
/coverage.out
/coverage.html
web/coverage/

# The built web client, written straight into the Go tree by the web build and
# embedded from there. Generated, so not tracked; a build without it compiles
# and serves an explanation, because the embed is behind a build tag.
/internal/webui/dist/

# Playwright output. Reports and traces are artefacts of a run, not of the tree.
web/test-results/
web/playwright-report/

# The client's digest manifest is a build output, published with the release.
# Kept out of the tree so it can never be mistaken for a statement about a
# revision it does not describe.
internal/webui/manifest.json
dist/
